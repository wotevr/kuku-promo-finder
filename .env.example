# Copy this file to .env and fill in ONE provider.
# Swapping the model = changing these lines. No code change.

# --- Google Gemini (default, native API). Free key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=paste-your-key-here
LLM_MODEL=gemini-3.6-flash
# gemini-flash-latest (newest model) was overloaded on the free tier (90 s timeouts), so the
# default is gemini-3.6-flash (~2 s). Check speeds with: python speed_test.py <model> <model> ...
# If you hit the daily limit: LLM_MODEL=gemini-flash-lite-latest  (or run `python check_setup.py`
# to list every model your key can use) and run again - saved answers are reused.

# --- Any OpenAI-compatible API: set LLM_PROVIDER=openai and one of these
# Groq (free):        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter (free):  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<a model id ending in :free>
# GitHub Models:      LLM_BASE_URL=https://models.github.ai/inference  LLM_MODEL=openai/gpt-4.1-mini
# OpenAI / Claude via a compatible gateway / local Ollama: same 3 lines with their URL, key, model
