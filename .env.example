# Copy this file to .env and fill in ONE provider. Any OpenAI-compatible API works.
# Swapping the model = changing these 3 lines. No code change.

# --- Google Gemini (default). Free key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=paste-your-key-here
LLM_MODEL=gemini-2.5-flash
# If you hit the daily limit, run `python check_setup.py` to see other model names
# (e.g. a "flash-lite" or newer "flash" model) and put one in LLM_MODEL.

# --- Groq (free). Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free models, ~50 requests/day). Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<any model id ending in :free, see openrouter.ai/models>

# --- GitHub Models (free with a GitHub account; personal access token with "models:read")
# LLM_BASE_URL=https://models.github.ai/inference
# LLM_API_KEY=github_pat_...
# LLM_MODEL=openai/gpt-4.1-mini
